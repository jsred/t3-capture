{
  "name": "t3-capture",
  "version": "0.2.0",
  "private": true,
  "description": "Extensión para Zen, Firefox y Chrome: capturá un elemento o pantalla y creá un hilo de T3 Code con contexto del DOM y eventos.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsred/t3-capture.git"
  },
  "type": "module",
  "scripts": {
    "lint": "web-ext lint -s extension",
    "build": "npm run build:firefox && npm run build:chrome",
    "build:firefox": "web-ext build -s extension -a dist --overwrite-dest --filename t3-capture-firefox-{version}.xpi",
    "build:chrome": "node scripts/build-chrome.mjs",
    "test": "node --test test/format.test.js",
    "test:live": "node test/live-t3.mjs",
    "test:dom": "node test/content-dom.mjs",
    "test:chrome": "node test/chrome-e2e.mjs",
    "test:firefox": "node test/firefox-e2e.mjs",
    "run:zen": "web-ext run -s extension --firefox=/Applications/Zen.app/Contents/MacOS/zen",
    "icons": "node scripts/render-icons.mjs"
  },
  "devDependencies": {
    "playwright": "^1.65.0",
    "web-ext": "^10.8.0"
  }
}
